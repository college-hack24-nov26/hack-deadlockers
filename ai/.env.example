# AI Model Configuration
STT_MODEL_SIZE=tiny
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto

# LLM Classifier Provider: groq_free (default) | gemini_free | ollama
LLM_PROVIDER=groq_free

# Required for the Groq classifier
GROQ_API_KEY=

# Optional Gemini fallback
GEMINI_API_KEY=

# Only needed when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional IndicConformer for Marathi
ENABLE_INDIC_CONFORMER=false

