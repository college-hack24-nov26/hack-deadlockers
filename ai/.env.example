# AI Model Configuration
STT_MODEL_SIZE=small
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto

# Detection mode: rules (local word-based, no LLM - default) | hybrid | llm
DETECTION_MODE=rules

# LLM Classifier Provider: ollama (default) | gemini_free | groq_free
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional Free Tier Fallbacks (Leave empty to use local Ollama with zero API keys)
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional IndicConformer for Marathi
ENABLE_INDIC_CONFORMER=false


# Opt-in: in hybrid mode, add phrases the LLM catches (and rules missed) as rules automatically
AUTO_LEARN=false
